<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright 2025 Enrico Saccon
  Licensed under the Apache License, Version 2.0.

  The semantics MoveIt needs on top of plantorv_sim's URDF. Written by hand
  rather than generated, because the workcell is small and the interesting part
  (which self-collisions to ignore) is short enough to state with reasons.

  The desk and the stand are part of the robot description, so they are checked
  against the arm like any other link. That is deliberate: the arm is mounted
  20 cm above a desk it can easily drive into, and having the planner know that
  is most of the value of modelling the desk at all. Only the pairs that touch
  by construction are turned off below.
-->
<robot name="ur3_workcell">

  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Matches plantorv_sim/config/initial_positions.yaml: elbow up, tool down
       over the desk, clear of the trays. -->
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="1.577254"/>
    <joint name="shoulder_lift_joint" value="-1.8715166"/>
    <joint name="elbow_joint" value="-1.5004596"/>
    <joint name="wrist_1_joint" value="-1.4109242"/>
    <joint name="wrist_2_joint" value="1.5727162"/>
    <joint name="wrist_3_joint" value="0.0376991"/>
  </group_state>

  <!-- The frame the fake grasp attaches objects to. -->
  <end_effector name="tool" parent_link="tool0" group="ur_manipulator"/>

  <!-- Consecutive links of the arm. -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <!-- Two joints apart and geometrically unable to meet. -->
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>

  <!-- The mounting stack. These are bolted together, so they are always in
       contact and would otherwise make every state invalid. -->
  <disable_collisions link1="table_link" link2="stand_link" reason="Adjacent"/>
  <disable_collisions link1="stand_link" link2="base_link_inertia" reason="Adjacent"/>
  <!-- The shoulder turns directly above the stand, within its footprint. -->
  <disable_collisions link1="stand_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="table_link" link2="base_link_inertia" reason="Never"/>

  <!-- The Robotiq 2F-85 on tool0, present whenever the description is built with
       attach_gripper on, which is the default.

       Every pair below was computed rather than guessed. The gripper is rigid
       apart from finger_joint, and its five other revolute joints mimic that
       one, so the relative pose of any two of these links is a function of a
       single number. Sweeping it across the full travel, from open to closed,
       and intersecting the collision meshes decides every pair outright. No
       pair collided over only part of the range, so "Never" below is a property
       of the mechanism rather than a sample that happened to miss.

       What is deliberately still checked is the gripper against the rest of the
       arm, the desk and the stand. That is the collision awareness worth having,
       now that the tool reaches 16 cm past tool0.

       With attach_gripper off, these pairs name links the URDF does not have,
       and srdfdom says so once each, at warning level:

         Link 'left_inner_finger' is not known to URDF. Cannot disable/enable
         collisons.

       It skips them and carries on, so the configuration still loads. Nine such
       warnings on startup mean the description was built without the gripper,
       not that anything is wrong here. -->

  <!-- Bolted together, and so always in contact. -->
  <disable_collisions link1="left_inner_finger" link2="left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="left_inner_knuckle" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_outer_finger" link2="left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="left_outer_knuckle" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_inner_finger" link2="right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="right_inner_knuckle" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_outer_finger" link2="right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="robotiq_85_base_link" reason="Adjacent"/>

  <!-- The gripper base overlaps the wrist it hangs from. There is no coupling
       plate between the flange and robotiq_85_base_link in this model, so the
       two meshes interpenetrate slightly where they meet. -->
  <disable_collisions link1="robotiq_85_base_link" link2="wrist_3_link" reason="Adjacent"/>

  <!-- The closing four bar. Each outer finger rides on its inner finger, so the
       pair is in contact throughout the travel, and they are not parent and
       child only because a URDF cannot state a closed loop. -->
  <disable_collisions link1="left_inner_finger" link2="left_outer_finger" reason="Default"/>
  <disable_collisions link1="right_inner_finger" link2="right_outer_finger" reason="Default"/>

  <!-- Cannot meet at any opening. -->
  <disable_collisions link1="left_inner_finger" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_inner_finger" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="right_inner_finger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="right_inner_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="right_inner_knuckle" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_outer_knuckle" link2="wrist_3_link" reason="Never"/>

</robot>
