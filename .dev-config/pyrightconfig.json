// Referenced from ../pyproject.toml via [tool.pyright] extends.
// NOTE: unlike Ruff, Pyright resolves relative paths against THIS FILE's directory,
// so every path below needs the ../ prefix to point back at the project root.
// Without it Pyright silently analyzes 0 files and still exits 0.
{
  "include": [
    "../samgpt.py",
    "../samdamcoords.py",
    "../segmentation",
    "../mapping",
    "../scene_understanding",
    "../evaluation",
    "../aruco",
    "../utility"
  ],
  "exclude": [
    "../**/__pycache__",
    "../.venv",
    "../venv",
    "../dataset",
    "../final_fast_segmentation",
    "../segmentation/checkpoints"
  ],
  // Same ../ caveat as above: venvPath is resolved against THIS file's
  // directory, so ".." is the project root and "venv" names the dir inside it.
  "venvPath": "..",
  "venv": ".venv",
  "pythonVersion": "3.10",
  "typeCheckingMode": "standard",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownParameterType": "none",
  // Dead-code checks, off by default in "standard" mode. Kept at "warning" on
  // purpose: Pyright only exits non-zero on errors, so these surface in the
  // editor and in `make typecheck` without blocking commits via the pre-commit
  // hook. Promote to "error" once the pre-existing type errors are cleared.
  // Note these are per-file checks - reportUnusedFunction/Class only fire on
  // private (underscore-prefixed) symbols, so an uncalled public function is
  // still invisible to them.
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportUnusedFunction": "warning",
  "reportUnusedClass": "warning",
  "reportUnusedExpression": "warning"
}
